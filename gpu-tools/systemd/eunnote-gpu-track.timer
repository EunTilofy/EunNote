[Unit]
Description=Report GPU state to EunNote every minute

[Timer]
OnStartupSec=20s
OnUnitInactiveSec=60s
# Keep the default cadence after reboot even if a monotonic trigger was missed.
OnCalendar=minutely
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true
Unit=eunnote-gpu-track.service

[Install]
WantedBy=timers.target
