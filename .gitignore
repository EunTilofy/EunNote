# Runtime dependencies
**/node_modules/
**/__pycache__/
*.py[cod]

# Private runtime state and uploaded media
clipboard/data/**
!clipboard/data/.gitkeep
shuji/data/**
!shuji/data/.gitkeep

# Local configuration and generated output
.env
.env.*
!.env.example
*.log
*.tmp
coverage/
.DS_Store

# Copilot credentials and migration exports (never commit real account files)
**/.copilot*/
**/copilot-api-migration/
**/copilot-api-migration*.tar*
**/github_token
**/copilot-config*.json
