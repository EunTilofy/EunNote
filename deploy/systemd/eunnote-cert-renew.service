[Unit]
Description=Renew EunNote HTTPS certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/eunnote/certbot-network.env
ExecStart=/opt/eunnote-certbot/bin/certbot renew --quiet --deploy-hook /usr/local/lib/eunnote/reload-nginx
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/lib/eunnote-acme
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
